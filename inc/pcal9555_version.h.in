/**
 * @file pcal9555_version.h
 * @brief PCAL9555 driver version, generated by CMake from pcal9555_version.h.in.
 * @copyright Copyright (c) 2026 The driver-pcal9555 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/pcal9555_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef PCAL9555_VERSION_H
#define PCAL9555_VERSION_H

/** Major version: incompatible API changes. */
#define PCAL9555_VERSION_MAJOR @PCAL9555_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define PCAL9555_VERSION_MINOR @PCAL9555_VERSION_MINOR@
/** Patch version: fixes. */
#define PCAL9555_VERSION_PATCH @PCAL9555_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define PCAL9555_VERSION_STRING "@PCAL9555_VERSION@"

#endif // PCAL9555_VERSION_H
